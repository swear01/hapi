Date: Sat, 28 Nov 2026 06:05:23 +0800
Subject: [PATCH] Verify migration logs include the chat folder schema

---
 hub/src/store/migration-v36.test.ts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/hub/src/store/migration-v36.test.ts b/hub/src/store/migration-v36.test.ts
index cdafe8107..481ba8942 100644
--- a/hub/src/store/migration-v36.test.ts
+++ b/hub/src/store/migration-v36.test.ts
@@ -18,8 +18,8 @@ it('adds passkey_credentials when upgrading a v35 database', () => {
         const migrated = new Store(path)
         try {
             expect(log.mock.calls).toEqual([
-                ['[Store] Migrating database schema from v35 to v36...'],
-                ['[Store] Database schema migration complete (v35 to v36).']
+                ['[Store] Migrating database schema from v35 to v37...'],
+                ['[Store] Database schema migration complete (v35 to v37).']
             ])
             const internalDb = (migrated as unknown as { db: Database }).db
             expect((internalDb.prepare('PRAGMA user_version').get() as { user_version: number }).user_version).toBe(37)
