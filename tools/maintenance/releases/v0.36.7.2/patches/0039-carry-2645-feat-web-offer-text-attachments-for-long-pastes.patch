+        state.message = {
+            id: 'user-text:long', role: 'user', createdAt: new Date(10),
+            content: [{ type: 'text', text }],
+            metadata: { custom: { kind: 'user', localId: null, sourceMessageId: 'stored-long', invokedAt: 10, isTranscriptEcho: false } }
