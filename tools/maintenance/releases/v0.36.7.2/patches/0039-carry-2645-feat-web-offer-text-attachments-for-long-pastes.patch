+
+    it.each(['中🙂'.repeat(2500), 'line\n'.repeat(100)])('keeps shorter prompts expanded', (text) => {
+        const restore = mountPrompt(text)
+        try {
+            expect(screen.queryByRole('button', { name: 'Show more' })).toBeNull()
+        } finally {
+            restore()
+        }
+    })
+
