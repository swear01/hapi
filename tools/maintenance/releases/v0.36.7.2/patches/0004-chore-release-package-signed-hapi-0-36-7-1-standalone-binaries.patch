+                  if-no-files-found: error
 
-                  cd ../release-artifacts
-                  sha256sum * > checksums.txt
+    sign-macos:
+        if: github.repository == 'swear01/hapi'
+        runs-on: macos-26
+        needs: cli
+        steps:
+            - uses: actions/download-artifact@v4
+              with:
+                  name: unsigned-binaries
+                  path: cli/dist-exe
+            - name: Import local release signing certificate
+              env:
+                  SIGNING_P12: ${{ secrets.MACOS_SIGNING_P12 }}
+                  SIGNING_P12_PASSWORD: ${{ secrets.MACOS_SIGNING_P12_PASSWORD }}
+              run: |
+                  test -n "$SIGNING_P12"
+                  test -n "$SIGNING_P12_PASSWORD"
+
+                  KEYCHAIN_PASSWORD="$(openssl rand -hex 32)"
+                  KEYCHAIN_PATH="$RUNNER_TEMP/hapi-signing.keychain-db"
+                  printf '%s' "$SIGNING_P12" | openssl base64 -d -A > "$RUNNER_TEMP/hapi-signing.p12"
+
+                  security create-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN_PATH"
+                  security set-keychain-settings -lut 21600 "$KEYCHAIN_PATH"
+                  security unlock-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN_PATH"
+                  security import "$RUNNER_TEMP/hapi-signing.p12" \
+                      -k "$KEYCHAIN_PATH" \
+                      -P "$SIGNING_P12_PASSWORD" \
+                      -T /usr/bin/codesign
+                  security set-key-partition-list \
+                      -S apple-tool:,apple: \
+                      -s \
+                      -k "$KEYCHAIN_PASSWORD" \
+                      "$KEYCHAIN_PATH"
+                  security list-keychains -d user -s "$KEYCHAIN_PATH"
+                  security find-identity -v -p codesigning "$KEYCHAIN_PATH"
+            - name: Sign and package macOS release artifacts
+              run: |
+                  mkdir -p cli/release-artifacts
+
+                  for target in bun-darwin-arm64 bun-darwin-x64; do
+                      binary="cli/dist-exe/$target/hapi"
+                      chmod 0755 "$binary"
+                      codesign \
+                          --force \
+                          --options runtime \
+                          --identifier xyz.hapi.cli \
+                          --keychain "$RUNNER_TEMP/hapi-signing.keychain-db" \
+                          --sign "HAPI Local Release Signing" \
+                          "$binary"
+                      codesign --verify --strict --verbose=2 "$binary"
+                      codesign --display --requirements - "$binary" 2>&1 \
+                          | grep -F 'identifier "xyz.hapi.cli"'
+                      tar -czvf "cli/release-artifacts/hapi-${target#bun-}.tar.gz" \
+                          -C "cli/dist-exe/$target" hapi
+                  done
+            - uses: actions/upload-artifact@v4
+              with:
+                  name: signed-macos-release-artifacts
+                  path: cli/release-artifacts/*
+                  if-no-files-found: error
+
+    release:
+        if: github.repository == 'swear01/hapi'
+        permissions:
+            contents: write
+        runs-on: ubuntu-latest
+        needs: [cli, sign-macos]
+        steps:
+            - uses: actions/checkout@v4
+              with:
+                  fetch-depth: 0
+            - uses: actions/download-artifact@v4
+              with:
+                  pattern: '*-release-artifacts'
+                  path: cli/release-artifacts
+                  merge-multiple: true
+            - name: Create checksums
+              run: |
+                  cd cli/release-artifacts
+                  sha256sum \
+                      hapi-darwin-arm64.tar.gz \
+                      hapi-darwin-x64.tar.gz \
+                      hapi-linux-arm64.tar.gz \
+                      hapi-linux-x64-baseline.tar.gz \
+                      hapi-win32-x64.zip > checksums.txt
+                  test "$(find . -maxdepth 1 -type f | wc -l)" -eq 6
             - name: Create Release
               env:
                   GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
               run: |
-                  gh release create "${GITHUB_REF#refs/tags/}" \
-                      --title "Release ${GITHUB_REF#refs/tags/}" \
-                      --generate-notes \
+                  git fetch origin main:refs/remotes/origin/main
+                  test "$(git rev-parse refs/remotes/origin/main)" = "$GITHUB_SHA"
+                  tag="${GITHUB_REF#refs/tags/}"
+                  notes_file=".github/release-notes/${tag}.md"
+                  test -s "$notes_file"
+                  gh release create "$tag" \
+                      --repo "$GITHUB_REPOSITORY" \
+                      --title "Release $tag" \
+                      --notes-file "$notes_file" \
                       cli/release-artifacts/*
-            - name: Update Homebrew formula
-              continue-on-error: true
-              env:
-                  GITHUB_TOKEN: ${{ secrets.HOMEBREW_TAP_TOKEN }}
-              run: |
-                  VERSION="${GITHUB_REF#refs/tags/v}"
-                  cd cli && bun run update-homebrew-formula --version "$VERSION" --push
