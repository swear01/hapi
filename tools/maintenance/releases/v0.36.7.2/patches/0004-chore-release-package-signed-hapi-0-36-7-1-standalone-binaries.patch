-              run: bun run --cwd cli publish-npm
-            - name: Package release artifacts
+            - name: Package CLI release artifacts
               run: |
                   cd cli/dist-exe
                   mkdir -p ../release-artifacts
 
                   for dir in bun-*/; do
                       target="${dir%/}"
-                      # bun-darwin-arm64 -> hapi-darwin-arm64
+                      if [[ "$target" == bun-darwin-* ]]; then
