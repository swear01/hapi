+            isObject(change) && typeof change.path === 'string' && change.path
+                ? [{ path: change.path, diff: patchDiff(change) }]
+                : [])
+    }
+    return Object.entries(input.changes).map(([path, change]) => ({ path, diff: patchDiff(change) }))
+}
