+import { act, renderHook } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { getProjectGroupCollapseStorageKey, useProjectGroupCollapse } from './useProjectGroupCollapse'
+
+function token(ns: string, uid = 1, exp = 100) {
+    const payload = JSON.stringify({ ns, uid, exp })
+    const bytes = new TextEncoder().encode(payload)
+    return `header.${btoa(String.fromCharCode(...bytes)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '')}.signature`
+}
+
+beforeEach(() => localStorage.clear())
+afterEach(() => vi.restoreAllMocks())
+
+describe('project collapse storage identity', () => {
+    it('isolates Hubs, namespaces and users, while surviving token refresh', () => {
+        const key = getProjectGroupCollapseStorageKey('https://hub.test/', token('default'))
+        expect(key).not.toBeNull()
+        expect(getProjectGroupCollapseStorageKey('https://hub.test', token('default', 1, 999))).toBe(key)
+        expect(getProjectGroupCollapseStorageKey('https://other.test', token('default'))).not.toBe(key)
+        expect(getProjectGroupCollapseStorageKey('https://hub.test', token('tenant'))).not.toBe(key)
+        expect(getProjectGroupCollapseStorageKey('https://hub.test', token('default', 2))).not.toBe(key)
+        expect(key).not.toContain('signature')
+    })
+
+    it('decodes non-ASCII namespaces and keeps Hub subpaths distinct', () => {
+        expect(getProjectGroupCollapseStorageKey('https://hub.test', token('用户'))).toContain('用户')
+        expect(getProjectGroupCollapseStorageKey('https://hub.test/hapi', token('default')))
+            .not.toBe(getProjectGroupCollapseStorageKey('https://hub.test', token('default')))
+    })
+
+    it.each(['', 'broken', 'header.not-json.signature', 'header.e30.signature'])(
+        'disables persistence rather than sharing an unknown identity: %s', value => {
+            expect(getProjectGroupCollapseStorageKey('https://hub.test', value)).toBeNull()
+        },
+    )
+})
+
+describe('project collapse storage failures', () => {
+    it.each(['broken-json', '[]', 'null', 'true', '"text"'])(
+        'ignores malformed saved state: %s', value => {
+            localStorage.setItem('scope', value)
+            const { result } = renderHook(() => useProjectGroupCollapse('scope'))
+            expect(result.current.collapseOverrides.size).toBe(0)
+        },
+    )
+
+    it('accepts only boolean choices and safely handles unusual project keys', () => {
+        localStorage.setItem('scope', '{"open":false,"closed":true,"invalid":"false","__proto__":true}')
+        const { result } = renderHook(() => useProjectGroupCollapse('scope'))
+        expect([...result.current.collapseOverrides]).toEqual([['open', false], ['closed', true], ['__proto__', true]])
+        act(() => result.current.setManualCollapse('constructor', false))
+        expect(JSON.parse(localStorage.getItem('scope')!).constructor).toBe(false)
+    })
+
+    it('keeps existing closed projects until explicitly reopened in the same scope', () => {
+        const legacy = 'hapi.closed-projects.v1:scope'
+        localStorage.setItem(legacy, JSON.stringify(['manual-reopen', 'keep-closed']))
+        const { result, unmount } = renderHook(() => useProjectGroupCollapse('scope', legacy))
+        expect(result.current.collapseOverrides.get('manual-reopen')).toBe(true)
+        act(() => result.current.setManualCollapse('manual-reopen', false))
+        unmount()
+        const reloaded = renderHook(() => useProjectGroupCollapse('scope', legacy))
+        expect(reloaded.result.current.collapseOverrides.get('manual-reopen')).toBe(false)
+        expect(reloaded.result.current.collapseOverrides.get('keep-closed')).toBe(true)
+        expect(localStorage.getItem(legacy)).toBe('["manual-reopen","keep-closed"]')
+    })
+
+    it('never writes automatic reveals, including after a later manual toggle', () => {
+        const { result } = renderHook(() => useProjectGroupCollapse('scope'))
+        act(() => result.current.revealGroup('auto'))
+        act(() => result.current.setManualCollapse('manual', false))
+        expect(JSON.parse(localStorage.getItem('scope')!)).toEqual({ manual: false })
+    })
+
+    it('bounds saved history without pruning groups absent from current results', () => {
+        const saved = Object.fromEntries(Array.from({ length: 2001 }, (_, i) => [`group-${i}`, false]))
+        localStorage.setItem('scope', JSON.stringify(saved))
+        const { result } = renderHook(() => useProjectGroupCollapse('scope'))
+        expect(result.current.collapseOverrides.size).toBe(2000)
+        act(() => result.current.setManualCollapse('new', true))
+        const restored = JSON.parse(localStorage.getItem('scope')!)
+        expect(Object.keys(restored)).toHaveLength(2000)
+        expect(restored['group-1']).toBeUndefined()
+        expect(restored.new).toBe(true)
+    })
+
+    it('keeps an unscoped list usable without storing preferences', () => {
+        const { result } = renderHook(() => useProjectGroupCollapse(null))
+        act(() => result.current.setManualCollapse('group', false))
+        expect(result.current.collapseOverrides.get('group')).toBe(false)
+        expect(localStorage.length).toBe(0)
+    })
+})
diff --git a/web/src/hooks/useProjectGroupCollapse.ts b/web/src/hooks/useProjectGroupCollapse.ts
new file mode 100644
index 000000000..708763a33
--- /dev/null
+++ b/web/src/hooks/useProjectGroupCollapse.ts
@@ -0,0 +1,106 @@
+import { useCallback, useState } from 'react'
+
+const STORAGE_PREFIX = 'hapi.projectGroupCollapse.v1.'
+const MAX_SAVED_GROUPS = 2000
+
+// Decode only stable identity claims, never store the JWT or access token.
+// This partitions a display preference; authentication remains the Hub's job.
+export function getProjectGroupCollapseStorageKey(baseUrl: string, token: string): string | null {
+    try {
+        const payload = token.split('.')[1]
+        if (!payload) return null
+        const base64 = payload.replace(/-/g, '+').replace(/_/g, '/')
+        const bytes = Uint8Array.from(atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, '=')), c => c.charCodeAt(0))
+        const claims: unknown = JSON.parse(new TextDecoder().decode(bytes))
+        if (!claims || typeof claims !== 'object') return null
+        const { uid, ns } = claims as { uid?: unknown; ns?: unknown }
+        if (typeof uid !== 'number' || !Number.isFinite(uid) || typeof ns !== 'string') return null
+        const hubUrl = new URL(baseUrl)
+        hubUrl.hash = ''
+        hubUrl.search = ''
+        const hub = hubUrl.toString().replace(/\/+$/, '')
+        return STORAGE_PREFIX + JSON.stringify([hub, uid, ns])
+    } catch {
+        return null
+    }
+}
+
+function readOverrides(key: string | null): Map<string, boolean> {
+    try {
+        if (!key) return new Map()
+        const parsed: unknown = JSON.parse(localStorage.getItem(key) ?? 'null')
+        if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return new Map()
+        return new Map(Object.entries(parsed)
+            .filter((entry): entry is [string, boolean] => typeof entry[1] === 'boolean')
+            .slice(-MAX_SAVED_GROUPS))
+    } catch {
+        return new Map()
+    }
+}
+
+function readLegacyFolds(key: string | null): Array<[string, boolean]> {
+    try {
+        if (!key) return []
+        const stored: unknown = JSON.parse(localStorage.getItem(key) ?? '[]')
+        return Array.isArray(stored)
+            ? stored.filter((value): value is string => typeof value === 'string').slice(-MAX_SAVED_GROUPS).map(value => [value, true])
+            : []
+    } catch {
+        return []
+    }
+}
+
+function loadState(storageKey: string | null, legacyFoldKey: string | null) {
+    // Honor existing main-branch closed projects. Explicit choices (including
+    // reopening one of those projects) take precedence without rewriting the old key.
+    const legacy = readLegacyFolds(legacyFoldKey)
+    const manual = readOverrides(storageKey)
+    const overrides = new Map([...legacy, ...manual])
+    return { storageKey, legacyFoldKey, manual, overrides }
+}
+
+export function useProjectGroupCollapse(storageKey: string | null, legacyFoldKey: string | null = null) {
+    const [state, setState] = useState(() => loadState(storageKey, legacyFoldKey))
+    // Restore the new identity before rendering it; never expose or write the
+    // previous Hub/user's choices under the new storage key.
+    if (state.storageKey !== storageKey || state.legacyFoldKey !== legacyFoldKey) {
+        setState(loadState(storageKey, legacyFoldKey))
+    }
+
+    const setManualCollapse = (groupKey: string, collapsed: boolean) => {
+        const manual = new Map(state.manual)
+        manual.delete(groupKey)
+        manual.set(groupKey, collapsed)
+        // Keep absent projects (loading/filtering can hide them), but bound
+        // storage growth as users visit new directories over time.
+        if (manual.size > MAX_SAVED_GROUPS) manual.delete(manual.keys().next().value!)
+        const overrides = new Map(state.overrides)
+        overrides.set(groupKey, collapsed)
+        setState({ storageKey, legacyFoldKey, manual, overrides })
+        try {
+            if (storageKey) {
+                localStorage.setItem(storageKey, JSON.stringify(Object.fromEntries(manual)))
+            } else if (legacyFoldKey) {
+                // Non-router callers still use the upstream closed-project list.
+                // Temporary reveals are not persisted in either format.
+                const closed = new Set(readLegacyFolds(legacyFoldKey).map(([key]) => key))
+                if (collapsed) closed.add(groupKey)
+                else closed.delete(groupKey)
+                localStorage.setItem(legacyFoldKey, JSON.stringify([...closed].slice(-MAX_SAVED_GROUPS)))
+            }
+        } catch {
+            // A blocked/full store must not prevent in-memory toggles.
+        }
+    }
+
+    const revealGroup = useCallback((groupKey: string) => {
+        setState(previous => {
+            if (previous.overrides.get(groupKey) === false) return previous
+            const overrides = new Map(previous.overrides)
+            overrides.set(groupKey, false)
+            return { ...previous, overrides }
+        })
+    }, [])
+
+    return { collapseOverrides: state.overrides, setManualCollapse, revealGroup }
+}
