+import HapiProtocol
+import SwiftUI
+
+struct CursorModelControls: View {
+    let catalog: CursorModelCatalog
+    let selection: String?
+    let onSelect: (String) -> Void
+
+    var body: some View {
+        let wire = CursorModelCatalog.selectionValue(selection)
+        let family = catalog.family(for: wire)
+        Picker("Model", selection: Binding(
+            get: { wire == "auto" ? "auto" : family },
+            set: { next in
+                guard let next, next != family else { return }
+                if next == "auto" {
+                    guard wire != "auto" else { return }
+                    onSelect("auto")
+                } else if let id = catalog.defaultWire(for: next) {
+                    onSelect(id)
+                }
+            }
+        )) {
+            Text("Auto").tag(String?.some("auto"))
+            if wire != "auto", family == nil {
+                (wire == "default" ? Text("Default") : Text(verbatim: wire)).tag(String?.none).disabled(true)
+            }
+            ForEach(catalog.families, id: \.self) { key in
+                Text(verbatim: catalog.label(for: key)).tag(Optional(key))
+            }
+        }
+
+        ForEach(Array(catalog.fields(for: wire).enumerated()), id: \.offset) { _, field in
+            Picker(LocalizedStringKey(field.title), selection: Binding(
+                get: { field.choices.firstIndex { $0.wire == wire } ?? 0 },
+                set: { index in
+                    if field.choices.indices.contains(index), let target = field.choices[index].wire, target != wire {
+                        onSelect(target)
+                    }
+                }
+            )) {
+                ForEach(Array(field.choices.enumerated()), id: \.offset) { index, choice in
+                    Text(LocalizedStringKey(choice.label)).tag(index).disabled(choice.wire == nil)
+                }
+            }
+        }
+    }
+}
diff --git a/ios/Hapi/Features/Chat/CursorModelErrorBanner.swift b/ios/Hapi/Features/Chat/CursorModelErrorBanner.swift
new file mode 100644
index 000000000..1b3b3e48f
--- /dev/null
+++ b/ios/Hapi/Features/Chat/CursorModelErrorBanner.swift
@@ -0,0 +1,87 @@
+import HapiClient
+import HapiProtocol
+import SwiftUI
+
+/// ChatView keys this view by eventId, including in-flight, accepted and
+/// failure state. A late response cannot dismiss or disable a newer alert.
+struct CursorModelErrorBanner: View {
+    let error: SessionModelError
+    let active: Bool
+    let abortRevision: Int
+    let perform: (ModelErrorAction) async throws -> Void
+
+    @State private var busy = false
+    @State private var queuedAtAbortRevision: Int?
+    @State private var dismissed = false
+    @State private var failure: String?
+
+    var body: some View {
+        if !dismissed {
+            VStack(alignment: .leading, spacing: 4) {
+                HStack(alignment: .firstTextBaseline) {
+                    let kind = error.kind.replacingOccurrences(of: "_", with: " ")
+                    if error.retriedAndFailed == true {
+                        Text("Bridge retry failed (\(kind))")
+                    } else if error.recovered {
+                        Text("Model recovered (\(kind))")
+                    } else {
+                        Text("Model error (\(kind))")
+                    }
+                    Spacer(minLength: 4)
+                    Button("Dismiss") { submit(.acknowledge) }
+                        .disabled(busy)
+                }
+                .fontWeight(.semibold)
+
+                if !error.recovered {
+                    if error.priorAssistantClaimsDone {
+                        Text("The agent reported completion before this error.")
+                    }
+                    if !error.rawSnippet.isEmpty {
+                        Text(verbatim: error.rawSnippet)
+                            .lineLimit(2)
+                    }
+                }
+                if error.canBridge(sessionActive: active) {
+                    if queuedAtAbortRevision == abortRevision {
+                        Text("Bridge retry queued")
+                    } else {
+                        Button("Bridge & retry") { submit(.bridge) }
+                            .disabled(busy)
+                    }
+                }
+                if let failure { Text(verbatim: failure) }
+            }
+            .font(.footnote)
+            .padding(.horizontal, 16)
+            .padding(.vertical, 6)
+            .frame(maxWidth: .infinity, alignment: .leading)
+            .background(.bar)
+            .onChange(of: active) { _, active in
+                if !active { queuedAtAbortRevision = nil }
+            }
+        }
+    }
+
+    private func submit(_ action: ModelErrorAction) {
+        guard !busy else { return }
+        busy = true
+        failure = nil
+        Task { @MainActor in
+            defer { busy = false }
+            do {
+                try await perform(action)
+                switch action {
+                case .bridge: queuedAtAbortRevision = abortRevision
+                case .acknowledge: dismissed = true
+                }
+            } catch is CancellationError {
+                return
+            } catch {
+                failure = hubErrorMessage(error)
+                    ?? (error as? APIError)?.code?.replacingOccurrences(of: "_", with: " ")
+                    ?? error.localizedDescription
+            }
+        }
+    }
+}
