++    try {
++        const raw = await readFile(settingsPath, 'utf8')
++        const settings = JSON.parse(raw) as HapiSettings
++        return typeof settings.cliApiToken === 'string' && settings.cliApiToken.length > 0
++            ? settings.cliApiToken
++            : null
++    } catch {
++        return null
++    }
++}
