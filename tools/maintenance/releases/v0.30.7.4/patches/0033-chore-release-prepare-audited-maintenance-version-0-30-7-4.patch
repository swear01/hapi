+-                    flushAndSend()
+-                    setShowContinueHint(false)
+-                }
++            const action = resolveComposerEnterKeyAction({
++                composerEnterBehavior,
++                isExpanded,
++                ctrlOrMeta: e.ctrlKey || e.metaKey,
++                altKey: e.altKey,
++            })
++            if (action === 'newline') {
+                 return
+             }
+             e.preventDefault()
+-            if (!e.ctrlKey && !e.altKey && !e.metaKey && canSend) {
++            if (action === 'send' && canSend) {
+                 flushAndSend()
+                 setShowContinueHint(false)
+             }
