+        self.assertIn('PROD_HOSTS="oracle swever cthulhu athena valkyrie zeus"', script)
+        self.assertIn("SMOKE_PATTERN='bun (hub/src/index[.]ts|cli/src/index[.]ts runner start-sync)'", script)
