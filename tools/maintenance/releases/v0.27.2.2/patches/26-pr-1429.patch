+            ]
+        })
+        expect(requests).toEqual([
+            { sessionId: 'native-batch-1', cursor: 0 },
+            { sessionId: 'native-batch-1', cursor: 1 },
+            { sessionId: 'native-batch-1', cursor: 2 },
+            { sessionId: 'native-batch-2', cursor: 0 },
+            { sessionId: 'native-batch-2', cursor: 1 }
