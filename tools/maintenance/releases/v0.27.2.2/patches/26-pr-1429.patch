+        )
+        store.messages.addMessage(existing.id, nativeTranscript.messages[0]!.content, 'web-user-1')
+        store.messages.addMessage(existing.id, nativeTranscript.messages[1]!.content)
+
+        const result = importClaudeSession({
+            store,
+            engine,
+            namespace: 'default',
