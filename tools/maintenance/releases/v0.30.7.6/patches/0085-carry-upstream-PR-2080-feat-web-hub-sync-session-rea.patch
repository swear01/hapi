+        api.updateSessionReadState.mockRejectedValue(new TypeError('offline'))
+        sync = startSessionReadSync(api, scope)
+        await tick()
+        markSessionSeen('a', 100)
+        await tick()
+        api.records.set('a', state(2, 99, 100))
+        sync.receive([state(2, 99, 100)])
