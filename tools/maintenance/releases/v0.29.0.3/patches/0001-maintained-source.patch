+                host: 'teemo',
+                platform: 'linux',
+                happyCliVersion: '0.20.2',
+                displayName: 'Teemo lab',
+            },
+            {
+                host: 'teemo',
+                platform: 'linux',
+                happyCliVersion: '0.23.0',
+                capabilities: ['cursor-chat-store-status'],
+            },
