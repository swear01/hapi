++export const NOTIFICATION_CLICK_MESSAGE_TYPE = 'HAPI_NOTIFICATION_CLICK'
++export const NOTIFICATION_CLICK_ACK_TYPE = 'HAPI_NOTIFICATION_CLICK_HANDLED'
