+        // Simulate a hub restart reading the file back.
+        resetFleetUpgradePolicyForTests()
+        initFleetUpgradePolicy({ dataDir, persisted: persisted?.fleetUpgradePolicy })
+        expect(getFleetUpgradePolicy()).toBe('silent')
