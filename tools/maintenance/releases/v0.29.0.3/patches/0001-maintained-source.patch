++        const child = spawn(process.execPath, ['-e', 'process.exit(0)']);
++        const pid = child.pid;
++        if (!pid) {
++            reject(new Error('failed to obtain a PID for the throwaway child process'));
++            return;
++        }
++        child.once('exit', () => resolvePid(pid));
++        child.once('error', reject);
++    });
++}
