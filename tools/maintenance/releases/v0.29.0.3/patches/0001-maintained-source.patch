+
+describe('normalizeCodexUsage', () => {
+    it('parses app-server token usage with context and rate-limit buckets', () => {
+        const usage = normalizeCodexUsage({
+            model_context_window: 200_000,
+            used_tokens: 35_000,
+            total_token_usage: {
