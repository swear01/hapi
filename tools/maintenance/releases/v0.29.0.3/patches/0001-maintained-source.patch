++        : {}
++    return {
++        ...message,
++        content: {
++            ...message.content,
++            content: {
++                type: 'output',
++                data: {
++                    type: 'assistant',
++                    ...(typeof source.uuid === 'string' ? { uuid: source.uuid } : {}),
++                    ...(typeof source.sessionId === 'string' ? { sessionId: source.sessionId } : {}),
++                    ...(typeof source.timestamp === 'string' ? { timestamp: source.timestamp } : {}),
