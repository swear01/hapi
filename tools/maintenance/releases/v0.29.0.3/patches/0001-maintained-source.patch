+                platform: 'linux',
+                happyCliVersion: '0.23.0',
+                capabilities: ['cursor-chat-store-status'],
+            },
+            {
+                host: 'teemo',
+                platform: 'linux',
+                happyCliVersion: '0.23.0',
+                capabilities: ['cursor-chat-store-status'],
+            },
