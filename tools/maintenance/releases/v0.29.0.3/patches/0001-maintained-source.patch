++                    <span>{dict.settingsPage.relay}</span>
++                    <input disabled={isServiceSettingDisabled} type="checkbox" checked={draft.relayEnabled} onChange={(event) => setDraft({ ...draft, relayEnabled: event.target.checked })} />
