++export type NotificationClickClient = {
++    url: string
++    focused?: boolean
++    focus: () => Promise<unknown>
++    navigate: (url: string) => Promise<NotificationClickClient | null>
++    postMessage?: (message: NotificationClickMessage, transfer: Transferable[]) => void
