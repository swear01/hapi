++    const remMin = totalMin % 60
++    if (totalHr < 24) {
++        return remMin > 0 ? `${totalHr}h ${remMin}m` : `${totalHr}h`
++    }
++    const days = Math.floor(totalHr / 24)
++    const remHr = totalHr % 24
++    return remHr > 0 ? `${days}d ${remHr}h` : `${days}d`
++}
