++        .replace(/([?&]token=)[^&\s]+/gi, '$1[REDACTED]')
++        .replace(/(Token:\s*)\S+/gi, '$1[REDACTED]')
++        .replace(/(CLI_API_TOKEN=)\S+/gi, '$1[REDACTED]')
++}
