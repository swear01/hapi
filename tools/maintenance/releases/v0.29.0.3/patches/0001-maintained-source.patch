+export async function runAcceptedSendCleanup<T>(
+    send: () => Promise<T | false>,
+    onAccepted: (value: T) => T,
+    cleanup: () => Promise<void>,
+): Promise<T | false> {
+    const accepted = await send()
+    if (!accepted) return false
+    const result = onAccepted(accepted)
+    await cleanup()
+    return result
