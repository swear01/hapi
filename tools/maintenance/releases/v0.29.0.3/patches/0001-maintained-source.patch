++        if (isQuitting) {
++            return
++        }
++        event.preventDefault()
++        mainWindow?.hide()
++    })
++
++    mainWindow.on('resize', () => void persistWindowBounds(configStore))
++    mainWindow.on('move', () => void persistWindowBounds(configStore))
++
++    app.on('before-quit', (event) => {
++        if (!quitRequested) {
++            event.preventDefault()
++            void requestQuit()
++            return
++        }
++        isQuitting = true
++    })
++
