++export function parseIoregPlatformUUID(stdout: string): string | undefined {
++    const match = /"IOPlatformUUID"\s*=\s*"([0-9A-Za-z-]+)"/.exec(stdout);
++    const uuid = match?.[1];
++    return uuid && UUID_PATTERN.test(uuid) ? uuid : undefined;
