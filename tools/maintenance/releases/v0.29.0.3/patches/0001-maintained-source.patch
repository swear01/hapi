+
+        expect(mergeMachineRegistrationMetadata(
+            {
+                host: 'teemo',
+                platform: 'linux',
+                happyCliVersion: '0.24.0',
+                capabilities: ['cursor-chat-store-status'],
+                cliArtifactGeneration: 'gen-a',
+            },
+            {
+                host: 'teemo',
+                platform: 'linux',
+                happyCliVersion: '0.24.0',
+                capabilities: ['cursor-chat-store-status'],
+            },
