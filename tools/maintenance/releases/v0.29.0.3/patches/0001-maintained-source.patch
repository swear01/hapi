++        expect(shouldRetrySessionReasoningEffortQuery(3)).toBe(false)
++    })
++
++    it('polls until the ACP handler returns effort options', () => {
++        expect(getSessionReasoningEffortRefetchInterval(true, undefined, 0)).toBe(1000)
