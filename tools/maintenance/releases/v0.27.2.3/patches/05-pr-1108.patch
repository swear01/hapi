+        names = readdirSync(binDir)
+    } catch {
+        return
+    }
+    for (const name of names) {
+        if (!VERSIONED_ARTIFACT_NAME_RE.test(name)) {
+            continue
+        }
+        const candidate = join(binDir, name)
+        if (candidate === keepPath) {
+            continue
+        }
+        try {
