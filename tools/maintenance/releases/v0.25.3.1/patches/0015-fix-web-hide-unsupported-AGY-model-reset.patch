From 3c3870dcc0555c94fa702e4596be9f422e48861a Mon Sep 17 00:00:00 2001
From: Junmo Kim <me@junmo.kim>
Date: Mon, 3 Aug 2026 02:19:52 +0900
Subject: [PATCH 15/19] fix(web): hide unsupported AGY model reset

---
 .../AssistantChat/modelOptions.test.ts        | 20 +++++++++++++++++++
 .../components/AssistantChat/modelOptions.ts  |  4 ++--
 2 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/web/src/components/AssistantChat/modelOptions.test.ts b/web/src/components/AssistantChat/modelOptions.test.ts
index 4b01e1e3..431846c0 100644
--- a/web/src/components/AssistantChat/modelOptions.test.ts
+++ b/web/src/components/AssistantChat/modelOptions.test.ts
@@ -2,6 +2,18 @@ import { describe, expect, it } from 'vitest'
 import { getModelOptionsForFlavor, getNextModelForFlavor } from './modelOptions'
 
 describe('getModelOptionsForFlavor', () => {
+    it('never offers the unsupported default reset in an active AGY session', () => {
+        for (const currentModel of [null, 'auto']) {
+            const options = getModelOptionsForFlavor('agy', currentModel)
+            expect(options.length).toBeGreaterThan(0)
+            expect(options.some((option) => option.value === null)).toBe(false)
+        }
+
+        const options = getModelOptionsForFlavor('agy', 'agy-custom-model')
+        expect(options[0]).toEqual({ value: 'agy-custom-model', label: 'agy-custom-model' })
+        expect(options.some((option) => option.value === null)).toBe(false)
+    })
+
     it('returns Gemini model options for gemini flavor', () => {
         const options = getModelOptionsForFlavor('gemini')
         expect(options[0]).toEqual({ value: null, label: 'Default' })
@@ -167,6 +179,14 @@ describe('getModelOptionsForFlavor', () => {
 })
 
 describe('getNextModelForFlavor', () => {
+    it('cycles AGY null, auto, and unknown current values only to concrete models', () => {
+        const firstConcrete = getModelOptionsForFlavor('agy').find((option) => option.value !== null)?.value
+        expect(firstConcrete).toBeTruthy()
+        expect(getNextModelForFlavor('agy', null)).toBe(firstConcrete)
+        expect(getNextModelForFlavor('agy', 'auto')).toBe(firstConcrete)
+        expect(getNextModelForFlavor('agy', 'agy-custom-model')).toBe(firstConcrete)
+    })
+
     it('cycles Gemini models', () => {
         const next = getNextModelForFlavor('gemini', null)
         expect(next).not.toBeNull()
diff --git a/web/src/components/AssistantChat/modelOptions.ts b/web/src/components/AssistantChat/modelOptions.ts
index d2c351f9..23075756 100644
--- a/web/src/components/AssistantChat/modelOptions.ts
+++ b/web/src/components/AssistantChat/modelOptions.ts
@@ -77,8 +77,8 @@ function getClaudeModelOptions(currentModel?: string | null, customOptions?: Mod
 }
 
 function getAgyModelOptions(currentModel?: string | null): ModelOption[] {
-    const options = MODEL_OPTIONS.agy.map((m) => ({
-        value: m.value === 'auto' ? null : m.value,
+    const options = MODEL_OPTIONS.agy.filter((m) => m.value !== 'auto').map((m) => ({
+        value: m.value,
         label: m.label
     }))
     return withCurrentModelOption(options, currentModel)
