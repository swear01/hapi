+function createRoutesApp(opts: { namespace: string; store: Store }): Hono<WebAppEnv> {
+    const app = new Hono<WebAppEnv>()
+    app.use('*', async (c, next) => {
+        c.set('namespace', opts.namespace)
+        await next()
+    })
+    app.route('/api', createCursorImportRoutes({
+        store: opts.store,
+        getSyncEngine: () => null
+    }))
+    return app
+}
