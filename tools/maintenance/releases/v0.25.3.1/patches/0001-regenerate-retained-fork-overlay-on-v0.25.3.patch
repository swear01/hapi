+            expect(screen.getByRole('button', { name: 'Import' })).toBeEnabled()
+        })
+
+        fireEvent.click(screen.getByRole('button', { name: 'Import' }))
+
+        expect(onConfirm).toHaveBeenCalledWith(['claude-session-2'])
