+    OutgoingMessageQueue: class {
+        constructor(_send: unknown) {}
+        enqueue = () => {};
+        releaseToolCall = async () => {};
+        flush = async () => {};
+        destroy = () => {};
+    }
+}));
+
+vi.mock('./utils/sdkToLogConverter', () => ({
