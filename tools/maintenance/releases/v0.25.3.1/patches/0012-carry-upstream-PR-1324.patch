+function makeQueuedMessage(scheduledAt: number | null = null, id = 'server-message-id'): DecryptedMessage {
+    return {
+        id,
+        localId: `local-${id}`,
+        createdAt: 1000,
+        seq: 1,
+        scheduledAt,
+        invokedAt: null,
+        status: 'queued',
