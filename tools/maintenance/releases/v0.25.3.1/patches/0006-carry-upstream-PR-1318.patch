+    useEffect(() => {
+        let cancelled = false
+        if (!props.api) {
+            return
+        }
+        try {
+            props.api.getClaudeCustomModels().then((result) => {
+                if (!cancelled) {
+                    setClaudeCustomModels(Array.isArray(result.models) ? result.models : [])
