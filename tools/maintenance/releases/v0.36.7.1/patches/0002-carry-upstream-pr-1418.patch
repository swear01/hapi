+            return
+        }
+        installCaret('caretPositionFromPoint', () => null)
+        installCaret('caretRangeFromPoint', () => {
+            if (api === 'miss') {
+                const range = document.createRange()
+                range.setStart(document.body, 0)
+                range.collapse(true)
+                return range
+            }
+            const range = document.createRange()
+            range.setStart(text, offset)
+            range.collapse(true)
+            return range
+        })
