From: swear01 <stanley.yellow1@gmail.com>
Date: Fri, 13 Nov 2026 03:55:50 +0800
Subject: [PATCH 25/28] fix(release): pin workflow Bun to packageManager and
 refresh desktop lockfile

---
 .github/workflows/fixtures.yml |   2 +-
 .github/workflows/release.yml  |   6 +-
 bun.lock                       | 554 ++++++++++++++++++++++++++++++++-
 3 files changed, 544 insertions(+), 18 deletions(-)

diff --git a/.github/workflows/fixtures.yml b/.github/workflows/fixtures.yml
index 04be4725a..02ab73b50 100644
--- a/.github/workflows/fixtures.yml
+++ b/.github/workflows/fixtures.yml
@@ -43,7 +43,7 @@ jobs:
             - uses: actions/checkout@v4
             - uses: oven-sh/setup-bun@v2
               with:
-                  bun-version: 1.4.0
+                  bun-version: 1.4.4
             - run: bun install --frozen-lockfile
             - name: Regenerate fixtures from the web pipeline
               run: bun run gen:fixtures
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 547c4c338..fc5815767 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -37,7 +37,7 @@ jobs:
                   grep -F 'Compared with the official release' "$notes_file"
             - uses: oven-sh/setup-bun@v2
               with:
-                  bun-version: 1.4.0
+                  bun-version: 1.4.4
             - run: bun install --frozen-lockfile
             - run: bun run build:single-exe:all
             - name: Package CLI release artifacts
@@ -141,7 +141,7 @@ jobs:
             - uses: actions/checkout@v4
             - uses: oven-sh/setup-bun@v2
               with:
-                  bun-version: 1.4.0
+                  bun-version: 1.4.4
             - run: bun install --frozen-lockfile
             - name: Download CLI release artifacts
               uses: actions/download-artifact@v4
@@ -185,7 +185,7 @@ jobs:
             - uses: actions/checkout@v4
             - uses: oven-sh/setup-bun@v2
               with:
-                  bun-version: 1.4.0
+                  bun-version: 1.4.4
             - run: bun install --frozen-lockfile
             - name: Download signed macOS CLI artifacts
               uses: actions/download-artifact@v4
