                 return [{
                     id,
                     status: asString(record?.status) ?? undefined,
-                    clientIds
+                    clientIds,
+                    userMessageCount,
+                    hasCompleteItems: true,
+                    hasContextCompaction
                 }]
             })
         } catch (error) {
@@ -258,7 +304,10 @@ export class CodexConversationHistory {
