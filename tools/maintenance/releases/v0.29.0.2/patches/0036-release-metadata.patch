+type RewindAckResult = { applied: boolean; error?: string }
+
+export async function waitForRewindAck(
+    ackPromise: Promise<RewindAckResult>,
+    timeoutMs: number
+): Promise<RewindAckResult> {
+    let timer: ReturnType<typeof setTimeout> | undefined
+    try {
+        return await Promise.race([
+            ackPromise,
+            new Promise<RewindAckResult>((resolve) => {
+                timer = setTimeout(() => resolve({ applied: false, error: 'unconfirmed' }), timeoutMs)
+            })
+        ])
+    } finally {
+        if (timer) clearTimeout(timer)
+    }
+}
+
+export function pruneDroppedRewindMappings(
+    promptUuidByLocalId: Map<string, string>,
+    localIdsByPromptUuid: Map<string, string[]>,
+    turns: Array<{ promptUuid: string }>,
+    dropPromptUuid: string
+): void {
+    const dropIndex = turns.findIndex((turn) => turn.promptUuid === dropPromptUuid)
+    const retainedPromptUuids = new Set(turns.slice(0, dropIndex).map((turn) => turn.promptUuid))
+    for (const [localId, promptUuid] of promptUuidByLocalId) {
+        if (!retainedPromptUuids.has(promptUuid)) promptUuidByLocalId.delete(localId)
+    }
+    for (const promptUuid of localIdsByPromptUuid.keys()) {
+        if (!retainedPromptUuids.has(promptUuid)) localIdsByPromptUuid.delete(promptUuid)
+    }
+}
