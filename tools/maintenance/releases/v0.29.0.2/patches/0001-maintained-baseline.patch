+export function withSessionJobInstruction(base: string): string {
+    const trimmed = base.trimEnd()
+    return trimmed.length > 0
+        ? `${trimmed}\n\n${SESSION_JOB_INSTRUCTION}`
+        : SESSION_JOB_INSTRUCTION
+}
