+    markerError: Error | null
+    channel: string
+    keepPath: string | undefined
+    binDir?: string
+}): void {
+    if (opts.markerError || opts.channel !== 'hub-artifact' || !opts.keepPath) {
+        return
+    }
+    pruneSupersededArtifacts(opts.keepPath, opts.binDir)
