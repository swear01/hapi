+        const dir = bin.ok ? bin.output.trim().split(/\r?\n/).filter(Boolean).at(-1)?.trim() : undefined
+        if (dir) {
+            for (const name of candidates) {
+                const path = join(dir, name)
+                if (existsSync(path)) {
