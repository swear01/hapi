+    const isWindowsShim = platform === 'win32' && /\.(cmd|bat)$/i.test(installed)
+    if (isWindowsShim) {
+        return {
+            command: comSpec,
+            args: ['/d', '/s', '/c', `"${installed}" --version`],
+        }
+    }
+    return { command: installed, args: ['--version'] }
