+
+function createSession(overrides: Partial<Session> = {}): Session {
+    return {
+        id: 'session-1',
+        namespace: 'default',
+        active: true,
+        metadata: { name: 'Demo task', flavor: 'codex' },
+        ...overrides
+    } as Session
+}
+
