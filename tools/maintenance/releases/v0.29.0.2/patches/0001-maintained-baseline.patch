+            expect(findArtifactMetaBySha256(offeredSha, dataDir)?.sha256).toBe(offeredSha)
+        } finally {
+            resetArtifactOfferRetentionForTests()
+            rmSync(dataDir, { recursive: true, force: true })
+        }
+    })
+})
