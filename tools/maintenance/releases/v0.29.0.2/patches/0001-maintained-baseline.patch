+                    sessionBOnSend(message)
+                } else {
+                    mockApi.sendMessage(sessionId, message)
+                }
+            },
+            approvePermission: async (_sessionId: string, _requestId: string) => {},
+            denyPermission: async (_sessionId: string, _requestId: string) => {}
