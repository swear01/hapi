+export function machineCanAutoUpgrade(machine: Machine): boolean {
+    if (machine.metadata?.versionHandoffDisabled === true) {
+        return false
+    }
+    return (machine.metadata?.capabilities ?? []).includes(MACHINE_CAPABILITIES.RunnerSelfUpgrade)
