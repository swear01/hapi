+        const res = await app.request('/api/notification-copy', {
+            method: 'PUT',
+            headers: { 'content-type': 'application/json' },
+            body: JSON.stringify({ ready: { title: 42 } })
+        })
+        expect(res.status).toBe(400)
+    })
+})
