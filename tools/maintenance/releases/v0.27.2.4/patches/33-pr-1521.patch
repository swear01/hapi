+                .map((p) => `  pid=${p.pid} ppid=${p.ppid} rss=${p.rssKb}KB ${p.command}`)
+                .join('\n')
+            auditError = new Error(
+                `[globalSetup] ${leftovers.length} test-owned process(es) survived teardown:\n${detail}`
+            )
+        }
