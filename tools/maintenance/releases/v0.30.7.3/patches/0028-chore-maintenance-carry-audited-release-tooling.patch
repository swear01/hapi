+
+    def test_rejects_unexpected_upstream_head(self):
+        env = os.environ | {'HAPI_UPSTREAM_SHA': '0' * 40}
+
+        result = run(
+            str(SCRIPT), '--repo', str(self.repo), '--patch-dir', str(self.patch_dir),
+            '--manifest', str(self.manifest), '--skip-tests', env=env, check=False,
