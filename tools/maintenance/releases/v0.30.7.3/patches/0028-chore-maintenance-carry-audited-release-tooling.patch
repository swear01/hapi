+            env=env,
+        )
+
+        self.assertEqual(0, result.returncode, result.stdout + result.stderr)
+        self.assertIn(f"Origin main: {replacement}", self.output.read_text())
+
+    def test_accepts_an_isolated_git_worktree(self):
