diff --git a/android/app/build.gradle.kts b/android/app/build.gradle.kts
index a7292fb55..2f2dbe5f2 100644
--- a/android/app/build.gradle.kts
+++ b/android/app/build.gradle.kts
@@ -80,7 +80,7 @@ android {
             value.toInt().also { require(it > 0) { "hapiVersionCode must be positive" } }
         }.orElse(1).get()
         // Tracks the hapi CLI/hub release train.
-        versionName = providers.gradleProperty("hapiVersionName").orElse("0.30.7").get()
+        versionName = providers.gradleProperty("hapiVersionName").orElse("0.30.7.3").get()
         testInstrumentationRunner = "androidx.test.runner.AndroidJUnitRunner"
     }
 
diff --git a/bun.lock b/bun.lock
index 19b5e23de..5c712ed9a 100644
--- a/bun.lock
+++ b/bun.lock
@@ -13,7 +13,6 @@
