Subject: [PATCH] fix(upgrade): fingerprint bundled native session skills

---
 .github/release-notes/v0.29.0.6.md  |  1 +
 hub/src/upgrade/cliArtifact.test.ts | 15 +++++++++++++++
 hub/src/upgrade/cliArtifact.ts      |  1 +
 3 files changed, 17 insertions(+)

diff --git a/.github/release-notes/v0.29.0.6.md b/.github/release-notes/v0.29.0.6.md
index e769791b7..a21aa0689 100644
--- a/.github/release-notes/v0.29.0.6.md
+++ b/.github/release-notes/v0.29.0.6.md
@@ -11,6 +11,7 @@ Compared with `v0.29.0.5`:
 - #1766 preserves the visible message prefix while rewind refreshes the latest window, retaining the maintained fork fallback and scroll-boundary behavior.
 - #1770 centers the inactive-session notice text.
 - #1773 adds a confirmed current-device mark-all-read action, including deduplicated source rows while excluding empty hidden stubs.
+- Include bundled skill files in Runner artifact fingerprints so skill-only updates cannot reuse stale binaries.
 - Install the bundled skill as `hapi-session-runtime` so existing user/Skillshare `hapi-session-control` symlinks remain untouched and cannot block new sessions.
 - Preserve session jobs, Runner artifact generations and workspace access, stream IDs, title-provider controls, and existing maintained security boundaries. The old HAPI summary-emission prompt setting is superseded by #1771; summary display and stored messages remain available.
 
diff --git a/hub/src/upgrade/cliArtifact.test.ts b/hub/src/upgrade/cliArtifact.test.ts
index 9b3a51f35..230b375ff 100644
--- a/hub/src/upgrade/cliArtifact.test.ts
+++ b/hub/src/upgrade/cliArtifact.test.ts
@@ -292,6 +292,21 @@ describe('fingerprintArtifactInputs / isArtifactCacheFresh', () => {
         }
     })
 
+    it('changes when the bundled native skill changes at the same version', () => {
+        const root = mkdtempSync(join(tmpdir(), 'hapi-artifact-skill-fp-'))
+        try {
+            const skillDir = join(root, 'cli', 'skills', 'hapi-session-runtime')
+            mkdirSync(skillDir, { recursive: true })
+            const skillPath = join(skillDir, 'SKILL.md')
+            writeFileSync(skillPath, 'first bundled skill')
+            const before = fingerprintArtifactInputs(root)
+            writeFileSync(skillPath, 'updated bundled skill')
+            expect(fingerprintArtifactInputs(root)).not.toBe(before)
+        } finally {
+            rmSync(root, { recursive: true, force: true })
+        }
+    })
+
     it('changes when cli bunfig.toml changes at the same package version', () => {
         const root = mkdtempSync(join(tmpdir(), 'hapi-artifact-bunfig-fp-'))
         try {
diff --git a/hub/src/upgrade/cliArtifact.ts b/hub/src/upgrade/cliArtifact.ts
index 6b5159c1d..9fa36ca8d 100644
--- a/hub/src/upgrade/cliArtifact.ts
+++ b/hub/src/upgrade/cliArtifact.ts
