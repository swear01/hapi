     const treeRoots = [
         join(monorepoRoot, 'cli', 'src'),
+        join(monorepoRoot, 'cli', 'skills'),
         join(monorepoRoot, 'hub', 'src'),
         join(monorepoRoot, 'shared', 'src'),
         join(monorepoRoot, 'cli', 'tools'),
