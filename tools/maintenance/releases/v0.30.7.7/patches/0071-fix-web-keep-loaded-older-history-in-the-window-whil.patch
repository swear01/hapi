+            wrapper: createWrapper(),
+        })
+
+        await act(async () => {
+            const outcome = await fetchOlderMessages(api, sessionId, {
+                shouldInstallBoundary: () => true,
+            })
+            expect(outcome.kind).toBe('applied')
+        })
