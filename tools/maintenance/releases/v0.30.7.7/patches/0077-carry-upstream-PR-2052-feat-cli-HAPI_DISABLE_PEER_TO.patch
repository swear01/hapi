+++ b/cli/src/modules/common/peerTools.test.ts
@@ -0,0 +1,34 @@
+import { afterEach, describe, expect, it } from 'vitest'
+import { isPeerToolsDisabled } from './peerTools'
+
+describe('isPeerToolsDisabled', () => {
+    const original = process.env.HAPI_DISABLE_PEER_TOOLS
+
+    afterEach(() => {
+        if (original === undefined) {
+            delete process.env.HAPI_DISABLE_PEER_TOOLS
+        } else {
+            process.env.HAPI_DISABLE_PEER_TOOLS = original
+        }
+    })
+
+    it('defaults to enabled (peer tools visible)', () => {
+        delete process.env.HAPI_DISABLE_PEER_TOOLS
+        expect(isPeerToolsDisabled()).toBe(false)
+    })
+
+    it.each(['1', 'true', 'TRUE', 'yes', 'Yes'])('disables peer tools for %s', (value) => {
+        process.env.HAPI_DISABLE_PEER_TOOLS = value
+        expect(isPeerToolsDisabled()).toBe(true)
+    })
+
+    it('stays enabled for unrelated values', () => {
+        process.env.HAPI_DISABLE_PEER_TOOLS = '0'
+        expect(isPeerToolsDisabled()).toBe(false)
+    })
+
+    it('reads from an explicit env object', () => {
+        expect(isPeerToolsDisabled({ HAPI_DISABLE_PEER_TOOLS: '1' } as NodeJS.ProcessEnv)).toBe(true)
+        expect(isPeerToolsDisabled({} as NodeJS.ProcessEnv)).toBe(false)
+    })
+})
diff --git a/cli/src/modules/common/peerTools.ts b/cli/src/modules/common/peerTools.ts
new file mode 100644
index 000000000..c4052bb52
--- /dev/null
+++ b/cli/src/modules/common/peerTools.ts
@@ -0,0 +1,18 @@
+/**
+ * Kill switch for the peer-session MCP tools (`ping_peer` / `inspect_peer` /
+ * `spawn_peer`).
+ *
+ * Set `HAPI_DISABLE_PEER_TOOLS=1` in the runner environment to stop wrapped
+ * agents from reading or messaging other HAPI sessions: the tools are not
+ * registered on the session MCP server and not advertised via
+ * `--allowedTools` / `--tools`. The ping/inspect core refuses as defense in
+ * depth, so `hapi ping-peer` / `inspect-peer` from inside a wrapped agent
+ * shell fails loudly. Operators who keep the variable unset in their
+ * interactive shell keep full CLI access.
+ */
+
+export const PEER_TOOL_NAMES = ['ping_peer', 'inspect_peer', 'spawn_peer'] as const;
+
+export function isPeerToolsDisabled(env: NodeJS.ProcessEnv = process.env): boolean {
+    return ['true', '1', 'yes'].includes((env.HAPI_DISABLE_PEER_TOOLS ?? '').toLowerCase());
+}
