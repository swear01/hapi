+            } finally {
+                time?.mockRestore();
+                releaseSoftSteer();
+                receipt.mockRestore();
+                harness.deferSoftSteer = null;
+                await stopTurn(stub, releasePrompt, runPromise);
+            }
+        }
+    );
+
