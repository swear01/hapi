---
 cli/src/claude/claudeRemote.test.ts | 45 +++++++++++++++++++++++++++++
 cli/src/claude/claudeRemote.ts      | 11 +++++--
 2 files changed, 54 insertions(+), 2 deletions(-)

diff --git a/cli/src/claude/claudeRemote.test.ts b/cli/src/claude/claudeRemote.test.ts
index 8b9f0d1cf..98791b724 100644
--- a/cli/src/claude/claudeRemote.test.ts
+++ b/cli/src/claude/claudeRemote.test.ts
@@ -521,3 +521,48 @@ describe('claudeRemote /compact result reporting', () => {
         expect(wireOrder).toEqual(['result', 'Compaction completed', 'ready']);
     }, 15_000);
 });
+
+describe('claudeRemote native permission mode', () => {
+    // A process launched natively in acceptEdits/bypassPermissions never calls
+    // canCallTool, so switching the session back to Default mid-session would
+    // silently keep auto-approving tools.
+    it.each([
+        ['default', 'default'],
+        ['acceptEdits', 'default'],
+        ['bypassPermissions', 'default'],
+        ['plan', 'plan'],
+        ['auto', 'auto'],
+    ] as const)('launches Claude for %s with --permission-mode %s', async (sessionMode, nativeMode) => {
+        const querySpy = vi.spyOn(claudeSdk, 'query').mockImplementation(queryMock as typeof claudeSdk.query);
+        const { claudeRemote } = await import('./claudeRemote');
+        queryMock.mockReturnValueOnce(createAsyncStream([
+            { type: 'result', subtype: 'success' } as unknown as SDKMessage
+        ]));
+
+        let nextCallCount = 0;
+        try {
+            await claudeRemote({
+                sessionId: 'session-1',
+                path: process.cwd(),
+                mcpServers: {},
+                claudeEnvVars: {},
+                claudeArgs: [],
+                allowedTools: [],
+                hookSettingsPath: '/tmp/hook.json',
+                canCallTool: async () => ({ behavior: 'allow', updatedInput: {} }),
+                nextMessage: async () => nextCallCount++ === 0
+                    ? { message: 'A', mode: { permissionMode: sessionMode } }
+                    : null,
+                onReady: () => {},
+                isAborted: () => false,
+                onSessionFound: () => {},
+                onMessage: () => {}
+            });
+
+            expect(queryMock.mock.calls[0][0].options.permissionMode).toBe(nativeMode);
+        } finally {
+            queryMock.mockReset();
+            querySpy.mockRestore();
+        }
+    });
+});
diff --git a/cli/src/claude/claudeRemote.ts b/cli/src/claude/claudeRemote.ts
index 8553b12fc..2079ec59b 100644
--- a/cli/src/claude/claudeRemote.ts
+++ b/cli/src/claude/claudeRemote.ts
@@ -24,6 +24,13 @@ export type SteerCallbacks = {
 
 export type SteerFunction = (message: string, callbacks: SteerCallbacks) => boolean;
 
+// acceptEdits/bypassPermissions are emulated in canCallTool so they can change
+// mid-session. Launching Claude natively in them skips canCallTool, so a later
+// downgrade (e.g. Yolo -> Default) would never take effect.
+function nativePermissionMode(mode: PermissionMode): PermissionMode {
+    return mode === 'acceptEdits' || mode === 'bypassPermissions' ? 'default' : mode;
+}
+
 export async function claudeRemote(opts: {
 
     // Fixed parameters
@@ -280,7 +287,7 @@ export async function claudeRemote(opts: {
         resume: startFrom ?? undefined,
         forkSession,
         mcpServers: opts.mcpServers,
-        permissionMode: bootstrapMode.permissionMode,
+        permissionMode: nativePermissionMode(bootstrapMode.permissionMode),
         model: bootstrapMode.model,
         effort: bootstrapMode.effort,
         fallbackModel: bootstrapMode.fallbackModel,
@@ -303,7 +310,7 @@ export async function claudeRemote(opts: {
             return;
         }
         initial = first;
-        sdkOptions.permissionMode = first.mode.permissionMode;
+        sdkOptions.permissionMode = nativePermissionMode(first.mode.permissionMode);
         sdkOptions.model = first.mode.model;
         sdkOptions.effort = first.mode.effort;
         sdkOptions.fallbackModel = first.mode.fallbackModel;
