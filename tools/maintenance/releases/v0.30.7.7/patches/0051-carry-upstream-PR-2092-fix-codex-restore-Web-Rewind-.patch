+import { afterEach, describe, expect, it } from 'vitest';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { SharedRewindBarrier, isNativeHistoryRead } from './rewind';
+
+const homes: string[] = [];
+afterEach(async () => { for (const home of homes.splice(0)) await rm(home, { recursive: true, force: true }); });
+async function fixture() {
+    const home = await mkdtemp(join(tmpdir(), 'hapi-rewind-')); homes.push(home);
+    const file = join(home, 'barrier.json');
+    return { file, barrier: new SharedRewindBarrier(file) };
+}
+describe('shared rewind admission', () => {
+    it('excludes in-flight writes and prevents new writes until commit', async () => {
+        const { barrier } = await fixture();
+        const release = barrier.enter();
+        await expect(barrier.begin()).rejects.toThrow('in flight');
+        release(); release();
+        const token = await barrier.begin();
+        expect(() => barrier.enter()).toThrow('rewind');
+        await expect(barrier.begin()).rejects.toThrow('rewind');
+        await barrier.complete(token, async () => {});
+        barrier.enter()();
+        await barrier.complete(token, async () => { throw new Error('Must not repeat'); });
+    });
+    it('retains quarantine across failed commit and process replacement', async () => {
+        const { file, barrier } = await fixture();
+        const token = await barrier.begin();
+        await expect(barrier.complete(token, async () => { throw new Error('Hub lost'); })).rejects.toThrow('Hub lost');
+        expect(() => barrier.enter()).toThrow();
+        const replacement = new SharedRewindBarrier(file); await replacement.load();
+        expect(() => replacement.enter()).toThrow();
+        await expect(replacement.complete(token, async () => {})).rejects.toThrow('Invalid');
+    });
+    it('unlocks only a proven rejection before native dispatch', async () => {
+        const { file, barrier } = await fixture();
+        await barrier.begin(); await barrier.cancel();
+        const replacement = new SharedRewindBarrier(file); await replacement.load();
+        replacement.enter()();
+    });
+    it('treats new native methods as mutations by default', () => {
+        expect(isNativeHistoryRead('thread/turns/list')).toBe(true);
+        for (const method of ['turn/start', 'turn/steer', 'thread/queue/add', 'thread/queue/start',
+            'thread/settings/update', 'thread/compact/start', 'thread/fork', 'thread/revert', 'future/write']) {
+            expect(isNativeHistoryRead(method)).toBe(false);
+        }
+    });
+});
diff --git a/cli/src/codex/shared/rewind.ts b/cli/src/codex/shared/rewind.ts
new file mode 100644
index 000000000..970c993a6
--- /dev/null
+++ b/cli/src/codex/shared/rewind.ts
@@ -0,0 +1,58 @@
+import { mkdir, readFile, writeFile, unlink } from 'node:fs/promises';
+import { dirname } from 'node:path';
+import { randomUUID } from 'node:crypto';
+
+/** A per-root admission barrier, held until the hub acknowledges its durable truncate.
+ * An uncertain native mutation is never unlocked by a timer or process restart. */
+export class SharedRewindBarrier {
+    private token?: string;
+    private completed?: string;
+    private writers = 0;
+    private completing?: Promise<void>;
+    constructor(private readonly file: string) {}
+
+    get blocked(): boolean { return this.token !== undefined; }
+    async load(): Promise<void> {
+        try { await readFile(this.file); this.token = 'reconciliation-required'; }
+        catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; }
+    }
+    assertOpen(): void {
+        if (this.blocked) throw new Error('Conversation rewind is pending or requires reconciliation; new operations are blocked');
+    }
+    enter(): () => void {
+        this.assertOpen(); this.writers++;
+        let released = false;
+        return () => { if (!released) { released = true; this.writers--; } };
+    }
+    async begin(): Promise<string> {
+        this.assertOpen();
+        if (this.writers) throw new Error('Session has operations in flight');
+        const token = this.token = randomUUID();
+        try {
+            await mkdir(dirname(this.file), { recursive: true, mode: 0o700 });
+            await writeFile(this.file, JSON.stringify({ token }), { mode: 0o600, flag: 'wx' });
+        } catch (error) { this.token = undefined; throw error; }
+        return token;
+    }
+    /** Only before native dispatch: rejection is proven, so no reconciliation is needed. */
+    async cancel(): Promise<void> {
+        await unlink(this.file); this.token = undefined;
+    }
+    async complete(token: string, reconcile: () => Promise<void>): Promise<void> {
+        if (this.completing) await this.completing;
+        if (!this.blocked && this.completed === token) return;
+        if (!this.token || token !== this.token || token === 'reconciliation-required') throw new Error('Invalid rewind transaction');
+        this.completing = (async () => {
+            await reconcile();
+            await unlink(this.file);
+            this.completed = token; this.token = undefined;
+        })();
+        try { await this.completing; } finally { this.completing = undefined; }
+    }
+}
+
+/** Reads do not change context; unknown/new native methods are writes by default. */
+export function isNativeHistoryRead(method: string): boolean {
+    return ['thread/read', 'thread/turns/list', 'thread/items/list', 'thread/queue/list',
+        'thread/goal/get', 'thread/memory/read'].includes(method);
+}
